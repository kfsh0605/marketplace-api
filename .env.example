# Порт, на якому запускається HTTP-сервер
PORT=3000

# Середовище виконання: development | test | production
NODE_ENV=development

# Підключення до PostgreSQL (через PgBouncer, pool_mode=transaction)
DB_HOST=localhost
DB_PORT=6432
DB_USER=marketplace
DB_NAME=marketplace
DATABASE_URL=postgres://marketplace:changeme@localhost:6432/marketplace
# RabbitMQ (ДЗ №19): AMQP-порт 5672 (НЕ 15672 — це веб-панель управління)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=marketplace
# Повний URL збирає scripts/with-secrets.sh із secrets/rabbitmq_password
RABBITMQ_URL=amqp://marketplace:changeme@localhost:5672

# Redis (ДЗ №23): два інстанси. Кеш: allkeys-lru. Черга й сесії: noeviction + AOF
REDIS_URL=redis://127.0.0.1:6390
REDIS_QUEUE_URL=redis://127.0.0.1:6380
# 1 вимикає Redis повністю: API працює без кешу й ліміту (e2e, CI)
REDIS_DISABLED=0
# Скільки reverse-proxy стоїть перед API (потрібно, щоб rate-limit бачив справжній IP клієнта)
TRUST_PROXY_HOPS=0
# Auth (ДЗ №24): значення приїжджають зі сховища (secrets/jwt/<dev|prod>/ через scripts/with-secrets.sh), у git їх немає
JWT_KID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=